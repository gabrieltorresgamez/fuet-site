---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { allPosts, tagSlug } from '../../lib';

export async function getStaticPaths() {
	const posts = await allPosts();
	const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
	return tags.map((tag) => ({
		params: { slug: tagSlug(tag) },
		props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
	}));
}

const { tag, posts } = Astro.props;
---

<Base title={tag} description={`Posts filed under ${tag}.`}>
	<header class="intro">
		<h1>{tag}</h1>
		<p class="meta">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
	</header>
	<PostList posts={posts} />
</Base>
